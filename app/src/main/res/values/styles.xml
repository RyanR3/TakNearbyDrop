<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Must inherit a full platform theme so framework attrs resolve when the plugin
         context inflates layouts. -->
    <style name="ATAKPluginTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AppTheme" parent="@android:style/Theme.Holo">
    </style>

    <style name="darkButton">
        <item name="android:background">@drawable/btn_gray</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="fieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/subtle_gray</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
</resources>
